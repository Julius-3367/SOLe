<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cash Flow Statement PDF Report Template (Indirect Method) -->
    <template id="dynamic_accounts_report.cash_flow_statement_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="data_report_dpi" t-value="110"/>
                <div class="page">
                    <h3>
                        <span t-esc="report_name"/>
                    </h3>
                    <br/>
                    <t t-set="cfs" t-value="data.get('data', {})"/>
                    <table cellspacing="0" width="100%"
                           style="border-collapse:collapse;border:1px solid #ccc;font-size:12px;">
                        <thead>
                            <tr style="background:#2E75B6;color:white;font-weight:bold;">
                                <th style="padding:6px 8px;width:70%;border:1px solid #ccc;">
                                    Description
                                </th>
                                <th style="padding:6px 8px;text-align:right;border:1px solid #ccc;">
                                    Amount
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- OPERATING ACTIVITIES -->
                            <tr style="background:#D6E4F0;font-weight:bold;">
                                <td colspan="2"
                                    style="padding:5px 8px;border:1px solid #ccc;">
                                    A. OPERATING ACTIVITIES
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px 4px 24px;border:1px solid #ccc;">
                                    Net Profit / (Loss)
                                </td>
                                <td style="padding:4px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('net_income', '0.00')"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px 4px 24px;border:1px solid #ccc;">
                                    Add: Depreciation &amp; Amortisation
                                </td>
                                <td style="padding:4px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('depreciation', '0.00')"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px 4px 24px;border:1px solid #ccc;">
                                    (Increase)/Decrease in Trade Receivables
                                </td>
                                <td style="padding:4px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('wc_receivables', '0.00')"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px 4px 24px;border:1px solid #ccc;">
                                    (Increase)/Decrease in Prepayments
                                </td>
                                <td style="padding:4px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('wc_prepayments', '0.00')"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px 4px 24px;border:1px solid #ccc;">
                                    (Increase)/Decrease in Other Current Assets
                                </td>
                                <td style="padding:4px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('wc_current_assets', '0.00')"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px 4px 24px;border:1px solid #ccc;">
                                    Increase/(Decrease) in Trade Payables
                                </td>
                                <td style="padding:4px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('wc_payables', '0.00')"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px 4px 24px;border:1px solid #ccc;">
                                    Increase/(Decrease) in Credit Card Liabilities
                                </td>
                                <td style="padding:4px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('wc_credit_card', '0.00')"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px 4px 24px;border:1px solid #ccc;">
                                    Increase/(Decrease) in Other Current Liabilities
                                </td>
                                <td style="padding:4px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('wc_current_liabilities', '0.00')"/>
                                </td>
                            </tr>
                            <tr style="background:#D6E4F0;font-weight:bold;">
                                <td style="padding:5px 8px;border:1px solid #ccc;">
                                    Net Cash from Operating Activities
                                </td>
                                <td style="padding:5px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('net_operating', '0.00')"/>
                                </td>
                            </tr>

                            <!-- spacer -->
                            <tr>
                                <td colspan="2" style="padding:4px;border:none;"/>
                            </tr>

                            <!-- INVESTING ACTIVITIES -->
                            <tr style="background:#D6E4F0;font-weight:bold;">
                                <td colspan="2"
                                    style="padding:5px 8px;border:1px solid #ccc;">
                                    B. INVESTING ACTIVITIES
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px 4px 24px;border:1px solid #ccc;">
                                    (Purchase)/Disposal of Fixed Assets (PP&amp;E)
                                </td>
                                <td style="padding:4px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('invest_fixed', '0.00')"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px 4px 24px;border:1px solid #ccc;">
                                    (Purchase)/Disposal of Non-current Assets
                                </td>
                                <td style="padding:4px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('invest_non_current', '0.00')"/>
                                </td>
                            </tr>
                            <tr style="background:#D6E4F0;font-weight:bold;">
                                <td style="padding:5px 8px;border:1px solid #ccc;">
                                    Net Cash from Investing Activities
                                </td>
                                <td style="padding:5px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('net_investing', '0.00')"/>
                                </td>
                            </tr>

                            <!-- spacer -->
                            <tr>
                                <td colspan="2" style="padding:4px;border:none;"/>
                            </tr>

                            <!-- FINANCING ACTIVITIES -->
                            <tr style="background:#D6E4F0;font-weight:bold;">
                                <td colspan="2"
                                    style="padding:5px 8px;border:1px solid #ccc;">
                                    C. FINANCING ACTIVITIES
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px 4px 24px;border:1px solid #ccc;">
                                    Proceeds from Share Issuance / Capital
                                </td>
                                <td style="padding:4px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('finance_equity', '0.00')"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px 4px 24px;border:1px solid #ccc;">
                                    Change in Retained / Unallocated Earnings
                                </td>
                                <td style="padding:4px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('finance_retained', '0.00')"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px 4px 24px;border:1px solid #ccc;">
                                    Proceeds from / (Repayment of) Long-term Borrowings
                                </td>
                                <td style="padding:4px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('finance_lt_liabilities', '0.00')"/>
                                </td>
                            </tr>
                            <tr style="background:#D6E4F0;font-weight:bold;">
                                <td style="padding:5px 8px;border:1px solid #ccc;">
                                    Net Cash from Financing Activities
                                </td>
                                <td style="padding:5px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('net_financing', '0.00')"/>
                                </td>
                            </tr>

                            <!-- spacer -->
                            <tr>
                                <td colspan="2" style="padding:6px;border:none;"/>
                            </tr>

                            <!-- SUMMARY -->
                            <tr style="background:#1B4F72;color:white;font-weight:bold;font-size:1.05em;">
                                <td style="padding:6px 8px;border:1px solid #ccc;">
                                    Net Increase / (Decrease) in Cash and Cash Equivalents
                                </td>
                                <td style="padding:6px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('net_change', '0.00')"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px;border:1px solid #ccc;">
                                    Opening Cash and Cash Equivalents
                                </td>
                                <td style="padding:4px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('opening_cash', '0.00')"/>
                                </td>
                            </tr>
                            <tr style="background:#1B4F72;color:white;font-weight:bold;font-size:1.05em;">
                                <td style="padding:6px 8px;border:1px solid #ccc;">
                                    Closing Cash and Cash Equivalents
                                </td>
                                <td style="padding:6px 8px;text-align:right;border:1px solid #ccc;">
                                    <t t-esc="cfs.get('closing_cash', '0.00')"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
