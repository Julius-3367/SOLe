<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_followup_reminder" model="mail.template">
            <field name="name">Follow-up Reminder</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Payment Reminder - Outstanding Balance</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <!-- body_html is rendered with QWeb, not inline_template: {{ }} only works in the fields above -->
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
    <!-- most customers have no company_id, fall back to the sender's company -->
    <t t-set="company" t-value="object.company_id or user.company_id"/>
    <p>Dear <t t-out="object.name or ''"/>,</p>

    <p>This is a friendly reminder that you have outstanding invoices with us.
    We kindly request you to settle the following balance at your earliest convenience.</p>

    <table style="border-collapse: collapse; width: 100%; margin: 20px 0;">
        <tr style="background-color: #f5f5f5;">
            <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">Invoice</th>
            <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">Date</th>
            <th style="border: 1px solid #ddd; padding: 8px; text-align: right;">Due Date</th>
            <th style="border: 1px solid #ddd; padding: 8px; text-align: right;">Amount Due</th>
        </tr>
        <t t-foreach="object.invoice_list" t-as="inv">
            <tr>
                <td style="border: 1px solid #ddd; padding: 8px;"><t t-out="inv.name or ''"/></td>
                <td style="border: 1px solid #ddd; padding: 8px;"><t t-out="inv.invoice_date or ''"/></td>
                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;"><t t-out="inv.invoice_date_due or ''"/></td>
                <td style="border: 1px solid #ddd; padding: 8px; text-align: right; color: #c0392b; font-weight: bold;">
                    <t t-out="inv.amount_residual" t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/>
                </td>
            </tr>
        </t>
    </table>

    <p style="font-size: 16px; font-weight: bold; color: #c0392b;">
        Total Outstanding: <t t-out="object.total_overdue" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
    </p>

    <p>Please contact us if you have any questions regarding your account or if payment has already been arranged.</p>

    <p>Thank you for your prompt attention to this matter.</p>

    <p>Kind regards,<br/>
    <t t-out="company.name or ''"/><br/>
    <t t-out="company.phone or ''"/><br/>
    <t t-out="company.email or ''"/>
    </p>
</div>
            </field>
        </record>

        <record id="ir_cron_send_followup_reminders" model="ir.cron">
            <field name="name">Send Follow-up Reminders</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="code">model._cron_send_followup_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
