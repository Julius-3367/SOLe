<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sole_whmcs_sync_log_list" model="ir.ui.view">
        <field name="name">sole.whmcs.sync.log.list</field>
        <field name="model">sole.whmcs.sync.log</field>
        <field name="arch" type="xml">
            <list string="WHMCS Sync Logs" decoration-success="state=='ok'"
                  decoration-warning="state=='warning'" decoration-danger="state=='error'">
                <field name="create_date" string="Date"/>
                <field name="config_id"/>
                <field name="sync_type"/>
                <field name="records_created"/>
                <field name="records_updated"/>
                <field name="error_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_sole_whmcs_sync_log_form" model="ir.ui.view">
        <field name="name">sole.whmcs.sync.log.form</field>
        <field name="model">sole.whmcs.sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log">
                <sheet>
                    <group>
                        <field name="config_id"/>
                        <field name="sync_type"/>
                        <field name="state"/>
                        <field name="records_created"/>
                        <field name="records_updated"/>
                        <field name="error_count"/>
                    </group>
                    <group string="Errors" invisible="not errors">
                        <field name="errors" widget="text" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sole_whmcs_sync_log" model="ir.actions.act_window">
        <field name="name">WHMCS Sync Logs</field>
        <field name="res_model">sole.whmcs.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
