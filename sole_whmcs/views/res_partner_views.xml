<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_whmcs" model="ir.ui.view">
        <field name="name">res.partner.form.whmcs</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <group string="WHMCS" invisible="not whmcs_client_id">
                    <field name="whmcs_client_id" readonly="True"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
