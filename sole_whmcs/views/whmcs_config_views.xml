<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sole_whmcs_config_form" model="ir.ui.view">
        <field name="name">sole.whmcs.config.form</field>
        <field name="model">sole.whmcs.config</field>
        <field name="arch" type="xml">
            <form string="WHMCS Configuration">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object"
                                class="oe_stat_button" icon="fa-history">
                            <field name="sync_log_count" widget="statinfo" string="Sync Logs"/>
                        </button>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="name"/>
                            <field name="api_url"/>
                            <field name="api_identifier"/>
                            <field name="api_secret" password="True"/>
                            <field name="is_active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Accounting">
                            <field name="default_journal_id"/>
                            <field name="default_account_id"/>
                            <field name="auto_post_paid"/>
                        </group>
                    </group>
                    <group string="Last Sync">
                        <field name="last_client_sync" readonly="1"/>
                        <field name="last_invoice_sync" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sole_whmcs_config_list" model="ir.ui.view">
        <field name="name">sole.whmcs.config.list</field>
        <field name="model">sole.whmcs.config</field>
        <field name="arch" type="xml">
            <list string="WHMCS Configurations">
                <field name="name"/>
                <field name="api_url"/>
                <field name="is_active"/>
                <field name="last_client_sync"/>
                <field name="last_invoice_sync"/>
            </list>
        </field>
    </record>

    <record id="action_sole_whmcs_config" model="ir.actions.act_window">
        <field name="name">WHMCS Configuration</field>
        <field name="res_model">sole.whmcs.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
