<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_staff_requests" model="res.groups.privilege">
        <field name="name">Staff Requests</field>
        <field name="sequence">14</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- Every internal user can request; approving needs no group, only being the approver.
         Paying posts a journal entry, so finance needs invoicing rights. -->
    <record id="group_staff_request_finance" model="res.groups">
        <field name="name">Finance (pays requests)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_staff_requests"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_staff_request_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_staff_requests"/>
        <field name="implied_ids" eval="[(4, ref('group_staff_request_finance'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_staff_request_own_or_approver" model="ir.rule">
        <field name="name">Staff request: own, or waiting on me</field>
        <field name="model_id" ref="model_sole_staff_request"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('approver_id', '=', user.id)]</field>
    </record>

    <record id="rule_staff_request_finance_all" model="ir.rule">
        <field name="name">Staff request: all (finance)</field>
        <field name="model_id" ref="model_sole_staff_request"/>
        <field name="groups" eval="[(4, ref('group_staff_request_finance'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_staff_request_company" model="ir.rule">
        <field name="name">Staff request: allowed companies</field>
        <field name="model_id" ref="model_sole_staff_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_staff_request_type_company" model="ir.rule">
        <field name="name">Staff request type: allowed companies</field>
        <field name="model_id" ref="model_sole_staff_request_type"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
