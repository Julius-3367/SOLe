<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_staff_request_form" model="ir.ui.view">
        <field name="name">sole.staff.request.form</field>
        <field name="model">sole.staff.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="not can_approve"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject"
                            invisible="not can_approve"/>
                    <button name="action_open_pay_wizard" type="object" string="Pay"
                            class="btn-primary" invisible="not can_pay"/>
                    <button name="%(sole_staff_request.action_report_staff_request_voucher)d" type="action"
                            string="Print Voucher" invisible="state != 'paid'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'submitted', 'approved')"
                            confirm="Cancel this request?"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object" class="oe_stat_button"
                                icon="fa-book" string="Journal Entry" invisible="not move_id"
                                groups="sole_staff_request.group_staff_request_finance"/>
                    </div>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Recovered" bg_color="text-bg-success" invisible="recovery_status != 'done'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="department_id"/>
                            <field name="type_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="type_description" invisible="not type_description or state != 'draft'"
                                   class="text-muted" nolabel="1" colspan="2"/>
                        </group>
                        <group>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="date_needed" readonly="state != 'draft'"/>
                            <field name="approver_id" invisible="not approver_id"/>
                            <field name="approved_date" invisible="not approved_date"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <label for="purpose"/>
                    <field name="purpose" readonly="state != 'draft'"
                           placeholder="What the money is for, where, and for which client or task"/>
                    <group invisible="state != 'rejected'">
                        <field name="rejection_reason"/>
                    </group>
                    <group string="Payment" invisible="state != 'paid'">
                        <group>
                            <field name="journal_id"/>
                            <field name="payment_date"/>
                            <field name="payment_reference"/>
                        </group>
                        <group>
                            <field name="paid_by_id"/>
                            <field name="move_id" groups="sole_staff_request.group_staff_request_finance"/>
                        </group>
                    </group>
                    <group string="Payroll Recovery" invisible="not recover_via_payroll">
                        <group>
                            <field name="recover_via_payroll" readonly="state != 'draft'"/>
                            <field name="recovery_date" invisible="state != 'paid'"/>
                        </group>
                        <group>
                            <field name="recovery_status" invisible="state != 'paid'"/>
                            <field name="recovered_payslip_id" invisible="not recovered_payslip_id"/>
                        </group>
                    </group>
                    <field name="can_approve" invisible="1"/>
                    <field name="can_pay" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_staff_request_list" model="ir.ui.view">
        <field name="name">sole.staff.request.list</field>
        <field name="model">sole.staff.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancelled', 'rejected')"
                  decoration-info="state == 'submitted'"
                  decoration-warning="state == 'approved'"
                  decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="create_date" string="Requested" widget="date"/>
                <field name="employee_id"/>
                <field name="department_id" optional="hide"/>
                <field name="type_id"/>
                <field name="purpose" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="approver_id" optional="show"/>
                <field name="payment_date" optional="hide"/>
                <field name="recovery_status" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-warning="state == 'approved'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_staff_request_search" model="ir.ui.view">
        <field name="name">sole.staff.request.search</field>
        <field name="model">sole.staff.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="type_id"/>
                <field name="purpose"/>
                <field name="payment_reference"/>
                <filter name="my_requests" string="My Requests" domain="[('user_id', '=', uid)]"/>
                <filter name="to_approve_mine" string="Waiting on Me"
                        domain="[('approver_id', '=', uid), ('state', '=', 'submitted')]"/>
                <separator/>
                <filter name="submitted" string="Waiting Approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="To Pay" domain="[('state', '=', 'approved')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="to_recover" string="To Recover through Payroll"
                        domain="[('recovery_status', '=', 'pending')]"/>
                <separator/>
                <filter name="filter_create_date" string="Requested On" date="create_date"/>
                <filter name="filter_payment_date" string="Paid On" date="payment_date"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'type_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Month Paid" context="{'group_by': 'payment_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_staff_request_pivot" model="ir.ui.view">
        <field name="name">sole.staff.request.pivot</field>
        <field name="model">sole.staff.request</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="type_id" type="row"/>
                <field name="payment_date" interval="month" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_staff_request_graph" model="ir.ui.view">
        <field name="name">sole.staff.request.graph</field>
        <field name="model">sole.staff.request</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="payment_date" interval="month"/>
                <field name="type_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_staff_request_mine" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">sole.staff.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ask for money for work</p>
            <p>Transport to a client, airtime, lunch on a field day or a salary advance.
               Your manager approves it, then finance pays you.</p>
        </field>
    </record>

    <record id="action_staff_request_to_approve" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">sole.staff.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('approver_id', '=', uid)]</field>
        <field name="context">{'search_default_submitted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting for your approval</p>
        </field>
    </record>

    <record id="action_staff_request_to_pay" model="ir.actions.act_window">
        <field name="name">To Pay</field>
        <field name="res_model">sole.staff.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_approved': 1}</field>
    </record>

    <record id="action_staff_request_all" model="ir.actions.act_window">
        <field name="name">All Requests</field>
        <field name="res_model">sole.staff.request</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <record id="action_staff_request_report" model="ir.actions.act_window">
        <field name="name">Spending Analysis</field>
        <field name="res_model">sole.staff.request</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_paid': 1}</field>
    </record>
</odoo>
