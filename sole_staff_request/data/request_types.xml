<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Expense accounts are left for the accountant to set before the first payment -->
    <data noupdate="1">
        <record id="type_transport" model="sole.staff.request.type">
            <field name="name">Transport</field>
            <field name="sequence">10</field>
            <field name="company_id" eval="False"/>
            <field name="description">Fare or fuel for work travel. Say where you are going and why.</field>
        </record>
        <record id="type_airtime" model="sole.staff.request.type">
            <field name="name">Airtime / Data</field>
            <field name="sequence">20</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="type_meals" model="sole.staff.request.type">
            <field name="name">Meals (field work)</field>
            <field name="sequence">30</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="type_supplies" model="sole.staff.request.type">
            <field name="name">Office Supplies</field>
            <field name="sequence">40</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="type_salary_advance" model="sole.staff.request.type">
            <field name="name">Salary Advance</field>
            <field name="sequence">50</field>
            <field name="company_id" eval="False"/>
            <field name="recover_via_payroll" eval="True"/>
            <field name="description">Deducted from your next payslip.</field>
        </record>
        <record id="type_other" model="sole.staff.request.type">
            <field name="name">Other</field>
            <field name="sequence">90</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
