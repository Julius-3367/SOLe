<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_staff_request_reject_form" model="ir.ui.view">
        <field name="name">sole.staff.request.reject.form</field>
        <field name="model">sole.staff.request.reject</field>
        <field name="arch" type="xml">
            <form>
                <field name="request_id" invisible="1"/>
                <label for="reason" string="Why is this request rejected?"/>
                <field name="reason" placeholder="The requester sees this"/>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
