<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ── Tax Groups ─────────────────────────────────────────── -->
    <record id="tax_group_vat" model="account.tax.group">
        <field name="name">VAT</field>
        <field name="sequence">10</field>
    </record>
    <record id="tax_group_wht" model="account.tax.group">
        <field name="name">Withholding Tax</field>
        <field name="sequence">20</field>
    </record>

    <!-- ── Kenya Standard VAT — 16% ──────────────────────────── -->
    <record id="tax_vat_16_sale" model="account.tax">
        <field name="name">VAT 16% (Kenya)</field>
        <field name="amount">16.0</field>
        <field name="amount_type">percent</field>
        <field name="type_tax_use">sale</field>
        <field name="description">VAT16</field>
        <field name="country_id" ref="base.ke"/>
        <field name="tax_group_id" ref="tax_group_vat"/>
    </record>
    <record id="tax_vat_16_purchase" model="account.tax">
        <field name="name">VAT 16% (Kenya) — Purchase</field>
        <field name="amount">16.0</field>
        <field name="amount_type">percent</field>
        <field name="type_tax_use">purchase</field>
        <field name="description">VAT16P</field>
        <field name="country_id" ref="base.ke"/>
        <field name="tax_group_id" ref="tax_group_vat"/>
    </record>
    <!-- ── Withholding Tax 5% (services) ─────────────────────── -->
    <record id="tax_wht_5_purchase" model="account.tax">
        <field name="name">WHT 5% — Services (Kenya)</field>
        <field name="amount">-5.0</field>
        <field name="amount_type">percent</field>
        <field name="type_tax_use">purchase</field>
        <field name="description">WHT5</field>
        <field name="country_id" ref="base.ke"/>
        <field name="tax_group_id" ref="tax_group_wht"/>
    </record>
    <!-- ── Withholding Tax 3% (goods) ────────────────────────── -->
    <record id="tax_wht_3_purchase" model="account.tax">
        <field name="name">WHT 3% — Goods (Kenya)</field>
        <field name="amount">-3.0</field>
        <field name="amount_type">percent</field>
        <field name="type_tax_use">purchase</field>
        <field name="description">WHT3</field>
        <field name="country_id" ref="base.ke"/>
        <field name="tax_group_id" ref="tax_group_wht"/>
    </record>
</odoo>
