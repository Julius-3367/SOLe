<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="sole_kpi.KpiDashboard">
        <div class="skd_root">

            <!-- ── Header ─────────────────────────────────────────── -->
            <div class="skd_header">
                <div class="skd_header_left">
                    <div class="skd_logo">
                        <span class="fa fa-chart-bar"/>
                    </div>
                    <div>
                        <div class="skd_title">My KPI Dashboard</div>
                        <div class="skd_subtitle">Balanced Scorecard · Softlink Options Limited</div>
                    </div>
                </div>
                <div class="skd_header_right">
                    <div class="skd_period_wrap">
                        <span class="fa fa-calendar skd_period_icon"/>
                        <select class="skd_period_select" t-on-change="onPeriodChange">
                            <option value="">Select period…</option>
                            <t t-foreach="state.periods" t-as="p" t-key="p.id">
                                <option t-att-value="p.id"
                                        t-att-selected="p.id === state.currentPeriodId">
                                    <t t-esc="p.name"/>
                                    <t t-if="p.state === 'locked'"> ✓</t>
                                </option>
                            </t>
                        </select>
                    </div>
                </div>
            </div>

            <!-- ── Loading spinner ───────────────────────────────── -->
            <t t-if="state.loading">
                <div class="skd_loading">
                    <div class="skd_spinner"/>
                    <span>Loading KPI data…</span>
                </div>
            </t>

            <!-- ── No period selected ────────────────────────────── -->
            <t t-elif="!state.currentPeriodId">
                <div class="skd_empty">
                    <div class="skd_empty_icon">📊</div>
                    <div class="skd_empty_title">Select a period to view your scorecard</div>
                    <div class="skd_empty_sub">Choose a reporting period from the dropdown above. KPI entries recorded for that period will appear here as traffic-light cards.</div>
                </div>
            </t>

            <!-- ── No entries for this period ────────────────────── -->
            <t t-elif="state.categories.length === 0">
                <div class="skd_empty">
                    <div class="skd_empty_icon">📋</div>
                    <div class="skd_empty_title">No KPI entries for this period</div>
                    <div class="skd_empty_sub">Go to <strong>KPI Entry</strong> to record your actuals for this period. Your manager can also add entries on your behalf.</div>
                </div>
            </t>

            <!-- ── Dashboard body ─────────────────────────────────── -->
            <t t-else="">

                <!-- Summary bar -->
                <div class="skd_summary_bar">
                    <div class="skd_summary_stat skd_stat_green">
                        <div class="skd_stat_val" t-esc="state.counts.green"/>
                        <div class="skd_stat_lbl">Green ≥80%</div>
                    </div>
                    <div class="skd_summary_stat skd_stat_amber">
                        <div class="skd_stat_val" t-esc="state.counts.amber"/>
                        <div class="skd_stat_lbl">Amber 70–79%</div>
                    </div>
                    <div class="skd_summary_stat skd_stat_red">
                        <div class="skd_stat_val" t-esc="state.counts.red"/>
                        <div class="skd_stat_lbl">Red 60–69%</div>
                    </div>
                    <div class="skd_summary_stat skd_stat_black">
                        <div class="skd_stat_val" t-esc="state.counts.black"/>
                        <div class="skd_stat_lbl">Black &lt;60%</div>
                    </div>
                    <div class="skd_summary_stat skd_stat_grey">
                        <div class="skd_stat_val" t-esc="state.counts.grey"/>
                        <div class="skd_stat_lbl">No Data</div>
                    </div>
                    <div class="skd_summary_overall">
                        <div class="skd_overall_label">Overall Score</div>
                        <div class="skd_overall_ring_wrap">
                            <svg class="skd_overall_ring" viewBox="0 0 44 44">
                                <circle class="skd_ring_bg" cx="22" cy="22" r="18"/>
                                <circle class="skd_ring_fg"
                                        t-att-class="'skd_ring_fg skd_ring_' + state.overallStatus"
                                        cx="22" cy="22" r="18"
                                        t-att-stroke-dasharray="state.overallDash"/>
                            </svg>
                            <div class="skd_overall_pct"
                                 t-att-class="'skd_overall_pct skd_pct_' + state.overallStatus">
                                <t t-esc="state.overallPct + '%'"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Per-category sections -->
                <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                    <div class="skd_section">
                        <div class="skd_section_header">
                            <span class="skd_section_dot"
                                  t-att-style="'background:' + (cat.color || '#6c757d')"/>
                            <span class="skd_section_name" t-esc="cat.name"/>
                            <span class="skd_section_count">
                                <t t-esc="cat.entries.length"/> indicator<t t-if="cat.entries.length !== 1">s</t>
                            </span>
                        </div>
                        <div class="skd_tiles">
                            <t t-foreach="cat.entries" t-as="entry" t-key="entry.id">
                                <div t-att-class="'skd_tile skd_tile_' + entry.status">
                                    <div class="skd_tile_status_bar"/>
                                    <div class="skd_tile_body">
                                        <div class="skd_tile_name" t-esc="entry.indicator_name"/>
                                        <div class="skd_tile_actual">
                                            <t t-esc="entry.actual_display"/>
                                            <span class="skd_tile_unit" t-esc="' ' + entry.unit_label"/>
                                        </div>
                                        <div class="skd_tile_target">
                                            Target: <t t-esc="entry.target_display"/>
                                            <span class="skd_tile_unit" t-esc="' ' + entry.unit_label"/>
                                        </div>
                                        <div class="skd_tile_progress_wrap">
                                            <div class="skd_tile_progress_bar"
                                                 t-att-class="'skd_tile_progress_bar skd_prog_' + entry.status"
                                                 t-att-style="'width:' + Math.min(entry.achievement_pct, 100) + '%'"/>
                                        </div>
                                        <div class="skd_tile_footer">
                                            <span t-att-class="'skd_badge skd_badge_' + entry.status"
                                                  t-esc="entry.status_label"/>
                                            <span class="skd_tile_pct"
                                                  t-esc="Math.round(entry.achievement_pct) + '%'"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </t>

        </div>
    </t>

</templates>
