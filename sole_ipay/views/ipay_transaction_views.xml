<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sole_ipay_transaction_form" model="ir.ui.view">
        <field name="name">sole.ipay.transaction.form</field>
        <field name="model">sole.ipay.transaction</field>
        <field name="arch" type="xml">
            <form string="iPay Transaction">
                <header>
                    <button name="action_generate_url" type="object"
                            string="Generate Payment URL" class="btn-primary"
                            invisible="state not in ['draft', 'sent']"/>
                    <button name="action_open_payment_url" type="object"
                            string="Open Payment Page" class="btn-secondary"
                            invisible="not payment_url"/>
                    <button name="action_send_url_email" type="object"
                            string="Send URL to Customer" class="btn-secondary"
                            invisible="not payment_url"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,paid,failed"/>
                </header>
                <sheet>
                    <!-- Payment link banner: only shown after URL is generated -->
                    <div class="alert alert-success o_field_widget" role="alert"
                         invisible="not payment_url"
                         style="margin-bottom: 16px;">
                        <strong>Payment Link:</strong>
                        <div style="margin-top: 6px; word-break: break-all;">
                            <field name="payment_url" widget="url" nolabel="1"/>
                        </div>
                    </div>

                    <group>
                        <group string="Order Info">
                            <field name="order_id"/>
                            <field name="invoice_no"/>
                            <field name="amount"/>
                            <field name="partner_id"/>
                            <field name="config_id"/>
                        </group>
                        <group string="Customer">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="p1" invisible="not p1" optional="hide"/>
                            <field name="p2" invisible="not p2" optional="hide"/>
                            <field name="p3" invisible="not p3" optional="hide"/>
                            <field name="p4" invisible="not p4" optional="hide"/>
                        </group>
                    </group>

                    <group string="Linked Invoice" invisible="not invoice_id">
                        <field name="invoice_id" readonly="1"/>
                    </group>

                    <group string="Payment Result" invisible="state in ['draft', 'sent']">
                        <field name="ipay_status"/>
                        <field name="ipay_txn_ref"/>
                        <field name="move_id" string="Payment Entry"/>
                    </group>

                    <notebook invisible="not payment_url">
                        <page string="Hash / Debug">
                            <group>
                                <field name="hash_value" string="Hash"/>
                            </group>
                        </page>
                        <page string="Callback Data" invisible="not raw_callback">
                            <field name="raw_callback" widget="text"/>
                        </page>
                    </notebook>

                    <div class="o_form_statusbar" invisible="payment_url">
                        <span class="text-muted">
                            Fill in Order ID, Amount, Phone and Email, then click
                            <strong>Generate Payment URL</strong>.
                        </span>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sole_ipay_transaction_list" model="ir.ui.view">
        <field name="name">sole.ipay.transaction.list</field>
        <field name="model">sole.ipay.transaction</field>
        <field name="arch" type="xml">
            <list string="iPay Transactions" decoration-success="state=='paid'"
                  decoration-danger="state=='failed'" decoration-muted="state=='cancelled'">
                <field name="create_date" string="Date"/>
                <field name="order_id"/>
                <field name="invoice_no"/>
                <field name="amount"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="partner_id"/>
                <field name="ipay_txn_ref"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_sole_ipay_transaction_search" model="ir.ui.view">
        <field name="name">sole.ipay.transaction.search</field>
        <field name="model">sole.ipay.transaction</field>
        <field name="arch" type="xml">
            <search string="Search iPay Transactions">
                <field name="order_id"/>
                <field name="invoice_no"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="partner_id"/>
                <filter name="paid" string="Paid" domain="[('state','=','paid')]"/>
                <filter name="pending" string="Pending" domain="[('state','in',['draft','sent'])]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
            </search>
        </field>
    </record>

    <record id="action_sole_ipay_transaction" model="ir.actions.act_window">
        <field name="name">iPay Transactions</field>
        <field name="res_model">sole.ipay.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sole_ipay_transaction_search"/>
    </record>
</odoo>
