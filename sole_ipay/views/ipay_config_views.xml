<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sole_ipay_config_form" model="ir.ui.view">
        <field name="name">sole.ipay.config.form</field>
        <field name="model">sole.ipay.config</field>
        <field name="arch" type="xml">
            <form string="iPay Configuration">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transactions" type="object"
                                class="oe_stat_button" icon="fa-credit-card">
                            <field name="transaction_count" widget="statinfo" string="Transactions"/>
                        </button>
                    </div>

                    <!-- First-time setup guide -->
                    <div class="alert alert-info" role="alert" invisible="vendor_id">
                        <strong>Setup steps:</strong>
                        1. Enter your iPay <b>Vendor ID</b> and <b>Hash Key</b> (from your
                        iPay merchant dashboard).
                        2. Set the <b>Callback URL</b> to
                        <code>https://workspace.softlinkoptions.co.ke/sole/ipay/callback</code>.
                        3. Set the <b>Payment Journal</b> — required for automatic reconciliation.
                        4. Switch <b>Environment</b> to Live when ready to accept real payments.
                    </div>

                    <!-- Warning when journal is not set -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not vendor_id or account_journal_id">
                        <strong>Payment Journal not set.</strong>
                        Paid transactions will be recorded but no journal entry will be created
                        until you select a Payment Journal below.
                    </div>

                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="environment"/>
                            <field name="is_active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="iPay Credentials">
                            <field name="vendor_id"/>
                            <field name="hash_key" password="True"/>
                            <field name="currency"/>
                        </group>
                    </group>
                    <group>
                        <group string="Integration">
                            <field name="callback_url"
                                   help="Must be a public HTTPS URL. iPay will POST payment results here."/>
                            <field name="account_journal_id"
                                   help="Bank or iPay journal. Required for automatic payment reconciliation."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sole_ipay_config_list" model="ir.ui.view">
        <field name="name">sole.ipay.config.list</field>
        <field name="model">sole.ipay.config</field>
        <field name="arch" type="xml">
            <list string="iPay Configurations">
                <field name="name"/>
                <field name="environment"/>
                <field name="vendor_id"/>
                <field name="currency"/>
                <field name="account_journal_id"/>
                <field name="is_active"/>
                <field name="transaction_count"/>
            </list>
        </field>
    </record>

    <record id="action_sole_ipay_config" model="ir.actions.act_window">
        <field name="name">iPay Configuration</field>
        <field name="res_model">sole.ipay.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Opens a blank new-transaction form directly (used by "New Payment" menu) -->
    <record id="action_sole_ipay_new_transaction" model="ir.actions.act_window">
        <field name="name">New iPay Payment</field>
        <field name="res_model">sole.ipay.transaction</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
