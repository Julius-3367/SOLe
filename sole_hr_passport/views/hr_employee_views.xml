<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_passport_copy" model="ir.ui.view">
        <field name="name">hr.employee.form.passport.copy</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="driving_license" position="after">
                <field name="passport_copy" filename="passport_copy_name"/>
                <field name="passport_copy_name" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
