<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="module_category_hr_contract">
        <field name="name">Contracts</field>
        <field name="sequence">17</field>
    </record>

    <record model="res.groups.privilege" id="privilege_hr_contract">
        <field name="name">Contracts</field>
        <field name="category_id" ref="module_category_hr_contract"/>
    </record>

    <record id="group_hr_contract_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_hr_contract"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_hr_contract_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_hr_contract"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_contract_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
