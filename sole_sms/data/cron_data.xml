<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_sole_sms_process_batches" model="ir.cron">
        <field name="name">SOLe SMS: Process Scheduled Batches</field>
        <field name="model_id" ref="sole_sms.model_sole_sms_batch"/>
        <field name="state">code</field>
        <field name="code">model.search([('state','=','draft')]).action_send_all()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">False</field>
    </record>
</odoo>
