<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Credentials (api_key, username) must be entered via the UI after install:
        Settings > SOLe SMS > Providers.  Never commit API keys to git.
    -->
    <record id="sole_sms_provider_onfon" model="sole.sms.provider">
        <field name="name">OnfonMedia Kenya</field>
        <field name="provider_type">onfon</field>
        <field name="api_url">https://api.onfonmedia.co.ke/v1/sms/SendBulkSMS</field>
        <field name="sender_id">softlinkoptions</field>
        <field name="is_active">True</field>
        <!-- Stays in test_mode until admin enters real credentials and unchecks this. -->
        <field name="test_mode">True</field>
    </record>

    <record id="sole_sms_template_welcome" model="sole.sms.template">
        <field name="name">Welcome</field>
        <field name="body">Dear {customer_name}, welcome to SOLe. Contact us at support@sole.co.ke. — {company_name}</field>
        <field name="category">General</field>
    </record>
    <record id="sole_sms_template_payment_confirm" model="sole.sms.template">
        <field name="name">Payment Confirmation</field>
        <field name="body">Dear {customer_name}, your payment of KES {amount} (Ref: {ref}) has been received. Thank you. — {company_name}</field>
        <field name="category">Payments</field>
    </record>
    <record id="sole_sms_template_reminder" model="sole.sms.template">
        <field name="name">Payment Reminder</field>
        <field name="body">Dear {customer_name}, your payment of KES {amount} is due on {date}. Please pay promptly. — {company_name}</field>
        <field name="category">Payments</field>
    </record>
</odoo>
