<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sole_send_sms_wizard_form" model="ir.ui.view">
        <field name="name">sole.send.sms.wizard.form</field>
        <field name="model">sole.send.sms.wizard</field>
        <field name="arch" type="xml">
            <form string="Send SMS">
                <group>
                    <field name="provider_id"/>
                    <field name="template_id"/>
                    <field name="phone"/>
                    <field name="partner_id"/>
                </group>
                <group string="Message">
                    <field name="message" widget="text" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send SMS"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sole_sms_send_wizard" model="ir.actions.act_window">
        <field name="name">Send SMS</field>
        <field name="res_model">sole.send.sms.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
