<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sole_sms_batch_form" model="ir.ui.view">
        <field name="name">sole.sms.batch.form</field>
        <field name="model">sole.sms.batch</field>
        <field name="arch" type="xml">
            <form string="SMS Batch">
                <header>
                    <button name="action_send_all" type="object" string="Send Now"
                            invisible="state != 'draft'"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,done"/>
                </header>
                <sheet>
                    <div class="oe_stat_buttons" name="stat_buttons">
                        <div class="oe_stat_button">
                            <div class="o_stat_info">
                                <field name="total_count" class="o_stat_value"/>
                                <span class="o_stat_text">Total</span>
                            </div>
                        </div>
                        <div class="oe_stat_button">
                            <div class="o_stat_info">
                                <field name="sent_count" class="o_stat_value"/>
                                <span class="o_stat_text">Sent</span>
                            </div>
                        </div>
                        <div class="oe_stat_button">
                            <div class="o_stat_info">
                                <field name="failed_count" class="o_stat_value"/>
                                <span class="o_stat_text">Failed</span>
                            </div>
                        </div>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="provider_id"/>
                        <field name="template_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Message">
                        <field name="message" widget="text" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Recipients">
                            <field name="line_ids">
                                <list editable="bottom" decoration-success="state=='sent'"
                                      decoration-danger="state=='failed'">
                                    <field name="phone"/>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="state"/>
                                    <field name="error"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sole_sms_batch_list" model="ir.ui.view">
        <field name="name">sole.sms.batch.list</field>
        <field name="model">sole.sms.batch</field>
        <field name="arch" type="xml">
            <list string="SMS Batches" decoration-success="state=='done'"
                  decoration-muted="state=='running'">
                <field name="name"/>
                <field name="provider_id"/>
                <field name="total_count"/>
                <field name="sent_count"/>
                <field name="failed_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_sole_sms_batch" model="ir.actions.act_window">
        <field name="name">SMS Campaigns</field>
        <field name="res_model">sole.sms.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
