<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sole_sms_provider_form" model="ir.ui.view">
        <field name="name">sole.sms.provider.form</field>
        <field name="model">sole.sms.provider</field>
        <field name="arch" type="xml">
            <form string="SMS Provider">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="log_count" widget="statinfo" string="Logs"/>
                        </button>
                    </div>
                    <group>
                        <group string="Provider">
                            <field name="name"/>
                            <field name="provider_type"/>
                            <field name="is_active"/>
                            <field name="test_mode"/>
                            <field name="sender_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="API Credentials">
                            <field name="api_url"/>
                            <field name="api_key" password="True"/>
                            <field name="username"/>
                            <field name="timeout_s"/>
                        </group>
                    </group>
                    <group string="Generic HTTP Settings"
                           invisible="provider_type != 'generic_http'">
                        <field name="auth_header_name"/>
                        <field name="extra_params" widget="text"/>
                    </group>
                    <group string="Delivery Receipts (DLR)">
                        <field name="dlr_token" password="True"/>
                        <field name="dlr_url" readonly="1"
                               widget="CopyClipboardChar"
                               help="Configure this URL as the DLR callback in your Onfon account."/>
                        <button name="action_generate_dlr_token" type="object"
                                string="Generate New Token" class="btn-secondary"
                                confirm="This will invalidate the current token. Update your Onfon callback URL afterwards."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sole_sms_provider_list" model="ir.ui.view">
        <field name="name">sole.sms.provider.list</field>
        <field name="model">sole.sms.provider</field>
        <field name="arch" type="xml">
            <list string="SMS Providers">
                <field name="name"/>
                <field name="provider_type"/>
                <field name="sender_id"/>
                <field name="is_active"/>
                <field name="test_mode"/>
                <field name="log_count"/>
            </list>
        </field>
    </record>

    <record id="action_sole_sms_provider" model="ir.actions.act_window">
        <field name="name">SMS Providers</field>
        <field name="res_model">sole.sms.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
