<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_document_tag_list" model="ir.ui.view">
            <field name="name">document.tag.list</field>
            <field name="model">document.tag</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                </list>
            </field>
        </record>

        <record id="view_document_tag_form" model="ir.ui.view">
            <field name="name">document.tag.form</field>
            <field name="model">document.tag</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_document_tag" model="ir.actions.act_window">
            <field name="name">Tags</field>
            <field name="res_model">document.tag</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="menu_document_config"
            name="Configuration"
            parent="menu_documents"
            sequence="100"
            groups="group_document_manager"/>

        <menuitem
            id="menu_document_tags"
            name="Tags"
            parent="menu_document_config"
            action="action_document_tag"
            sequence="10"
            groups="group_document_manager"/>

    </data>
</odoo>
