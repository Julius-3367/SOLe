<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ── Module category ─────────────────────────────────────────────── -->
        <record model="ir.module.category" id="module_category_document">
            <field name="name">Document Management</field>
            <field name="description">Manage documents and folders.</field>
            <field name="sequence">20</field>
        </record>

        <!-- ── Privilege (Odoo 17+ settings grouping) ──────────────────────── -->
        <record model="res.groups.privilege" id="privilege_document">
            <field name="name">Document</field>
            <field name="category_id" ref="module_category_document"/>
        </record>

        <!-- ── Groups ──────────────────────────────────────────────────────── -->
        <record id="group_document_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_document"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_document_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_document"/>
            <field name="implied_ids" eval="[(4, ref('group_document_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- ── Record rules ────────────────────────────────────────────────── -->

        <!--
            Users: read ALL documents, but can only write/delete documents
            they own (user_id = current user). This allows the company to
            build a shared knowledge base that everyone can read.
        -->
        <record id="rule_document_user_write_own" model="ir.rule">
            <field name="name">Document: Users modify own documents only</field>
            <field name="model_id" ref="model_document_document"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_document_user'))]"/>
            <field name="perm_read"   eval="False"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            Managers bypass all domain restrictions — they can read, write,
            create and delete every document regardless of owner.
        -->
        <record id="rule_document_manager_all" model="ir.rule">
            <field name="name">Document: Managers access all documents</field>
            <field name="model_id" ref="model_document_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_document_manager'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
