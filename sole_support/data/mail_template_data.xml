<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_ticket_assigned" model="mail.template">
        <field name="name">Support Ticket: Assigned Notification</field>
        <field name="model_id" ref="sole_support.model_sole_support_ticket"/>
        <field name="subject">You have been assigned ticket [{{ object.name }}]: {{ object.subject }}</field>
        <field name="email_from">{{ object.company_id.email or user.email }}</field>
        <field name="email_to">{{ object.assigned_to.email }}</field>
        <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
    <p>Hi <t t-out="object.assigned_to.name or ''">Assignee</t>,</p>
    <p>A support ticket has been assigned to you.</p>
    <table style="border-collapse: collapse; width: 100%; margin: 16px 0;">
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold; width: 160px;">Ticket #</td>
            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="object.name or ''">TKT-00001</t></td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Subject</td>
            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="object.subject or ''">Ticket Subject</t></td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Customer</td>
            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="object.partner_id.name or ''">Customer Name</t></td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Priority</td>
            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="dict([('0','Low'),('1','Normal'),('2','High'),('3','Critical')]).get(object.priority, object.priority) or ''">Normal</t></td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Stage</td>
            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="object.stage_id.name or ''">Backlog</t></td>
        </tr>
        <t t-if="object.sla_deadline">
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">SLA Deadline</td>
            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="str(object.sla_deadline) or ''">2024-01-01 00:00:00</t></td>
        </tr>
        </t>
    </table>
    <t t-if="object.description">
    <p><strong>Description:</strong></p>
    <div style="background: #f9f9f9; padding: 12px; border-left: 4px solid #ccc;">
        <t t-out="object.description or ''">Description text</t>
    </div>
    </t>
    <p style="margin-top: 24px;">
        <a t-att-href="'/web#id=%s&amp;model=sole.support.ticket&amp;view_type=form' % object.id"
           style="background: #017e84; color: #fff; padding: 10px 20px; text-decoration: none; border-radius: 4px;">
            View Ticket
        </a>
    </p>
    <p style="color: #999; font-size: 12px; margin-top: 32px;">
        This is an automated message from <t t-out="object.company_id.name or ''">Company</t>.
    </p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <!--
        Acknowledgement sent to the customer when they raise a ticket
        themselves, through the portal or the public form at /support/request.

        email_from is deliberately not set. Odoo then composes the sender from
        the mail.default.from and mail.catchall.domain system parameters, which
        match the outgoing server's FROM filter. Hard-coding the company email
        would break if it sits on a different domain from the mail server.
    -->
    <record id="mail_template_ticket_acknowledgement" model="mail.template">
        <field name="name">Support Ticket: Customer Acknowledgement</field>
        <field name="model_id" ref="sole_support.model_sole_support_ticket"/>
        <field name="subject">We have received your request [{{ object.name }}]</field>
        <field name="email_to">{{ object.email or object.partner_id.email }}</field>
        <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
    <p>Hi <t t-out="object.partner_id.name or ''">there</t>,</p>
    <p>
        Thank you for getting in touch. We have logged your request and our
        support team will be in contact.
    </p>
    <table style="border-collapse: collapse; width: 100%; margin: 16px 0;">
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold; width: 160px;">Your reference</td>
            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="object.name or ''">TKT-00001</t></td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Subject</td>
            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="object.subject or ''">Ticket Subject</t></td>
        </tr>
        <t t-if="object.category_id">
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Category</td>
            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="object.category_id.name or ''">Category</t></td>
        </tr>
        </t>
    </table>
    <t t-if="object.description">
    <p><strong>What you told us:</strong></p>
    <div style="background: #f9f9f9; padding: 12px; border-left: 4px solid #ccc;">
        <t t-out="object.description or ''">Description text</t>
    </div>
    </t>
    <p>
        Please quote <strong><t t-out="object.name or ''">TKT-00001</t></strong>
        if you contact us about this request.
    </p>
    <p style="color: #999; font-size: 12px; margin-top: 32px;">
        This is an automated message from <t t-out="object.company_id.name or ''">Company</t>.
        Please do not reply to this address.
    </p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
