<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sole_support_stage_list" model="ir.ui.view">
        <field name="name">sole.support.stage.list</field>
        <field name="model">sole.support.stage</field>
        <field name="arch" type="xml">
            <list string="Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_resolved"/>
                <field name="is_closed"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="action_sole_support_stage" model="ir.actions.act_window">
        <field name="name">Ticket Stages</field>
        <field name="res_model">sole.support.stage</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
