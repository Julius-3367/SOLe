<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Support Dashboard views.
        Period coverage: weekly, monthly, quarterly, yearly.
        Measures: ticket count, avg response time, avg resolution time, SLA breach rate.
    -->

    <!-- Graph: tickets by stage, defaulting to monthly bars -->
    <record id="view_sole_support_ticket_graph" model="ir.ui.view">
        <field name="name">sole.support.ticket.graph</field>
        <field name="model">sole.support.ticket</field>
        <field name="arch" type="xml">
            <graph string="Support Tickets" type="bar" stacked="0">
                <field name="create_date" interval="month" type="row" string="Period"/>
                <field name="stage_id" type="col"/>
            </graph>
        </field>
    </record>

    <!-- Pivot: category × period with time and SLA measures -->
    <record id="view_sole_support_ticket_pivot" model="ir.ui.view">
        <field name="name">sole.support.ticket.pivot</field>
        <field name="model">sole.support.ticket</field>
        <field name="arch" type="xml">
            <pivot string="Support Metrics" display_quantity="1">
                <field name="create_date" interval="month" type="col" string="Month"/>
                <field name="category_id" type="row"/>
                <field name="response_time_hours" type="measure" string="Avg Response (hrs)"/>
                <field name="resolution_time_hours" type="measure" string="Avg Resolution (hrs)"/>
            </pivot>
        </field>
    </record>

    <!--
        Extended search view for the dashboard.
        Inherits the base ticket search and adds:
          - Period range filters: This Week / Month / Quarter / Year
          - Group-by: Week / Month / Quarter / Year
          - Status filters: Resolved, Closed, SLA Breached
    -->
    <record id="view_sole_support_dashboard_search" model="ir.ui.view">
        <field name="name">sole.support.ticket.dashboard.search</field>
        <field name="model">sole.support.ticket</field>
        <field name="inherit_id" ref="view_sole_support_ticket_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">

                <!-- ── Status filters ─────────────────────────────────── -->
                <separator/>
                <filter name="resolved" string="Resolved"
                        domain="[('stage_id.is_resolved', '=', True)]"/>
                <filter name="closed" string="Closed"
                        domain="[('stage_id.is_closed', '=', True)]"/>
                <filter name="sla_breached" string="SLA Breached"
                        domain="[('is_sla_breached', '=', True)]"/>

                <!--
                    Odoo's native date filter. Provides This Month / This Quarter /
                    This Year plus period-over-period comparison, evaluated by the
                    framework.

                    Replaces four hand-written domains that called date.replace()
                    and used floor division. py.js, the client-side Python
                    evaluator, implements neither, so rendering the search view
                    raised "Function.prototype.apply was called on undefined" and
                    the Reports page failed to load.
                -->
                <separator/>
                <filter name="filter_create_date" string="Creation Date" date="create_date"/>

                <!-- ── Period group-by ────────────────────────────────── -->
                <separator/>
                <filter name="by_week" string="Group by Week"
                        context="{'group_by': 'create_date:week'}"/>
                <filter name="by_month" string="Group by Month"
                        context="{'group_by': 'create_date:month'}"/>
                <filter name="by_quarter" string="Group by Quarter"
                        context="{'group_by': 'create_date:quarter'}"/>
                <filter name="by_year" string="Group by Year"
                        context="{'group_by': 'create_date:year'}"/>

                <!-- ── Other group-by ─────────────────────────────────── -->
                <filter name="by_category_dash" string="Group by Category"
                        context="{'group_by': 'category_id'}"/>
                <filter name="by_assignee_dash" string="Group by Assignee"
                        context="{'group_by': 'assigned_to'}"/>

            </xpath>
        </field>
    </record>

    <!-- Dashboard action: graph → pivot → list with the full search view -->
    <record id="action_sole_support_dashboard" model="ir.actions.act_window">
        <field name="name">Support Dashboard</field>
        <field name="res_model">sole.support.ticket</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_sole_support_ticket_search"/>
        <field name="context">{'search_default_filter_create_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tickets yet — start by creating one.
            </p>
        </field>
    </record>
</odoo>
