<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sole_support_category_list" model="ir.ui.view">
        <field name="name">sole.support.category.list</field>
        <field name="model">sole.support.category</field>
        <field name="arch" type="xml">
            <list string="Categories" editable="bottom">
                <field name="name"/>
                <field name="description"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="action_sole_support_category" model="ir.actions.act_window">
        <field name="name">Ticket Categories</field>
        <field name="res_model">sole.support.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
