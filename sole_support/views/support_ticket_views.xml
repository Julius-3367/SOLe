<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_sole_support_ticket" model="ir.sequence">
        <field name="name">Support Ticket</field>
        <field name="code">sole.support.ticket</field>
        <field name="prefix">TKT-</field>
        <field name="padding">5</field>
    </record>

    <!-- Ticket Form -->
    <record id="view_sole_support_ticket_form" model="ir.ui.view">
        <field name="name">sole.support.ticket.form</field>
        <field name="model">sole.support.ticket</field>
        <field name="arch" type="xml">
            <form string="Support Ticket">
                <header>
                    <button name="action_assign_to_me" type="object"
                            string="Assign to Me" class="btn-secondary"/>
                    <button name="action_resolve" type="object"
                            string="Mark Resolved" class="btn-primary"/>
                    <button name="action_close" type="object"
                            string="Close Ticket" class="btn-secondary"/>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="subject" placeholder="Subject..."/></h2>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group string="Ticket Info">
                            <field name="category_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="assigned_to"/>
                            <field name="sla_deadline"/>
                            <field name="is_portal"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" widget="html"/>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Ticket List -->
    <record id="view_sole_support_ticket_list" model="ir.ui.view">
        <field name="name">sole.support.ticket.list</field>
        <field name="model">sole.support.ticket</field>
        <field name="arch" type="xml">
            <list string="Support Tickets" decoration-danger="priority=='3'"
                  decoration-warning="priority=='2'">
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="category_id"/>
                <field name="priority" widget="priority"/>
                <field name="stage_id"/>
                <field name="assigned_to"/>
                <field name="sla_deadline"/>
                <field name="create_date" string="Created"/>
            </list>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_sole_support_ticket_kanban" model="ir.ui.view">
        <field name="name">sole.support.ticket.kanban</field>
        <field name="model">sole.support.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id">
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="priority"/>
                <field name="assigned_to"/>
                <field name="kanban_state"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb-2">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="subject"/>
                                </strong>
                                <small class="o_kanban_record_subtitle text-muted">
                                    <field name="name"/>
                                </small>
                            </div>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div class="o_kanban_record_body">
                            <field name="partner_id"/>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <field name="kanban_state" widget="state_selection"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search -->
    <record id="view_sole_support_ticket_search" model="ir.ui.view">
        <field name="name">sole.support.ticket.search</field>
        <field name="model">sole.support.ticket</field>
        <field name="arch" type="xml">
            <search string="Search Tickets">
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="name"/>
                <separator/>
                <filter name="my_tickets" string="My Tickets"
                        domain="[('assigned_to', '=', uid)]"/>
                <filter name="open" string="Open"
                        domain="[('stage_id.is_closed', '=', False)]"/>
                <filter name="critical" string="Critical"
                        domain="[('priority', '=', '3')]"/>
                <separator/>
                <filter name="by_stage" string="Group by Stage"
                        context="{'group_by': 'stage_id'}"/>
                <filter name="by_category" string="Group by Category"
                        context="{'group_by': 'category_id'}"/>
                <filter name="by_assignee" string="Group by Assignee"
                        context="{'group_by': 'assigned_to'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sole_support_ticket" model="ir.actions.act_window">
        <field name="name">Support Tickets</field>
        <field name="res_model">sole.support.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_sole_support_ticket_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
