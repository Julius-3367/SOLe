<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_sole_support_ticket" model="ir.sequence">
        <field name="name">Support Ticket</field>
        <field name="code">sole.support.ticket</field>
        <field name="prefix">TKT-</field>
        <field name="padding">5</field>
    </record>

    <!-- Ticket Form -->
    <record id="view_sole_support_ticket_form" model="ir.ui.view">
        <field name="name">sole.support.ticket.form</field>
        <field name="model">sole.support.ticket</field>
        <field name="arch" type="xml">
            <form string="Support Ticket">
                <header>
                    <button name="action_assign_to_me" type="object"
                            string="Assign to Me" class="btn-secondary"/>
                    <button name="action_escalate" type="object"
                            string="Escalate" class="btn-danger"
                            invisible="is_escalated"/>
                    <button name="action_deescalate" type="object"
                            string="Remove Escalation" class="btn-secondary"
                            invisible="not is_escalated"/>
                    <!-- Mark Resolved: hidden once ticket is resolved or closed -->
                    <button name="action_resolve" type="object"
                            string="Mark Resolved" class="btn-primary"
                            invisible="is_ticket_resolved or is_ticket_closed"/>
                    <!-- Close Ticket: hidden once ticket is closed -->
                    <button name="action_close" type="object"
                            string="Close Ticket" class="btn-secondary"
                            invisible="is_ticket_closed"/>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <!-- Hidden fields used in invisible expressions -->
                    <field name="is_ticket_resolved" invisible="1"/>
                    <field name="is_ticket_closed" invisible="1"/>
                    <field name="previous_ticket_count" invisible="1"/>

                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_customer_tickets" type="object"
                                class="oe_stat_button" icon="fa-ticket"
                                invisible="not partner_id or previous_ticket_count == 0">
                            <div class="o_stat_info">
                                <field name="previous_ticket_count" class="o_stat_value"/>
                                <span class="o_stat_text">Prior Tickets</span>
                            </div>
                        </button>
                    </div>

                    <div class="alert alert-danger" role="alert"
                         invisible="not is_escalated">
                        <strong>&#x26A0; Escalated</strong>
                        <span invisible="not escalated_to"> — Assigned to <field name="escalated_to" readonly="1" nolabel="1" class="d-inline"/></span>
                        <span invisible="not escalated_date"> on <field name="escalated_date" readonly="1" nolabel="1" class="d-inline"/></span>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="subject" placeholder="Subject..."/></h2>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group string="Ticket Info">
                            <field name="category_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="assigned_to"/>
                            <field name="sla_deadline"/>
                            <field name="is_portal"/>
                        </group>
                    </group>
                    <group string="Escalation" invisible="not is_escalated">
                        <field name="is_escalated" invisible="1"/>
                        <field name="escalated_to"/>
                        <field name="escalated_date" readonly="1"/>
                        <field name="escalation_reason" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" widget="html"/>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <!-- Customer history: auto-loads when partner is selected -->
                        <page string="Customer History" invisible="not partner_id">
                            <div class="text-muted mb-2" invisible="previous_ticket_ids">
                                No previous tickets found for this customer.
                            </div>
                            <field name="previous_ticket_ids" readonly="1"
                                   invisible="not previous_ticket_ids">
                                <list string="Previous Tickets"
                                      decoration-danger="is_escalated or priority == '3'"
                                      decoration-warning="priority == '2'">
                                    <field name="name" string="Ticket #"/>
                                    <field name="subject"/>
                                    <field name="stage_id" string="Stage"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="category_id" string="Category"/>
                                    <field name="create_date" string="Opened"/>
                                    <field name="date_closed" string="Closed"/>
                                    <field name="is_escalated" widget="boolean" string="Escalated"/>
                                </list>
                            </field>
                        </page>
                        <!-- Smart suggestions: resolved tickets in the same category -->
                        <page string="Suggested Resolutions">
                            <div class="text-muted mb-2" invisible="suggested_ticket_ids">
                                No similar resolved tickets found.
                                <span invisible="not category_id"> Try selecting a category to narrow suggestions.</span>
                            </div>
                            <field name="suggested_ticket_ids" readonly="1"
                                   invisible="not suggested_ticket_ids">
                                <list string="Similar Resolved Tickets">
                                    <field name="name" string="Ticket #"/>
                                    <field name="subject"/>
                                    <field name="category_id" string="Category"/>
                                    <field name="description" string="Resolution Notes" optional="show"/>
                                    <field name="date_closed" string="Resolved On"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Ticket List -->
    <record id="view_sole_support_ticket_list" model="ir.ui.view">
        <field name="name">sole.support.ticket.list</field>
        <field name="model">sole.support.ticket</field>
        <field name="arch" type="xml">
            <list string="Support Tickets"
                  decoration-danger="is_escalated or priority=='3'"
                  decoration-warning="priority=='2'">
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="category_id"/>
                <field name="priority" widget="priority"/>
                <field name="is_escalated" string="Escalated" widget="boolean"/>
                <field name="stage_id"/>
                <field name="assigned_to"/>
                <field name="sla_deadline"/>
                <field name="resolution_time_hours" string="Resolution (hrs)" optional="hide"/>
                <field name="create_date" string="Created"/>
            </list>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_sole_support_ticket_kanban" model="ir.ui.view">
        <field name="name">sole.support.ticket.kanban</field>
        <field name="model">sole.support.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id">
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="priority"/>
                <field name="assigned_to"/>
                <field name="kanban_state"/>
                <field name="is_escalated"/>
                <templates>
                    <t t-name="card" t-att-class="record.is_escalated.raw_value ? 'border-danger' : ''">
                        <div class="o_kanban_record_top mb-2">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="subject"/>
                                </strong>
                                <small class="o_kanban_record_subtitle text-muted">
                                    <field name="name"/>
                                </small>
                            </div>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div class="o_kanban_record_body">
                            <field name="partner_id"/>
                            <span t-if="record.is_escalated.raw_value"
                                  class="badge text-bg-danger ms-1">Escalated</span>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <field name="kanban_state" widget="state_selection"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search -->
    <record id="view_sole_support_ticket_search" model="ir.ui.view">
        <field name="name">sole.support.ticket.search</field>
        <field name="model">sole.support.ticket</field>
        <field name="arch" type="xml">
            <search string="Search Tickets">
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="name"/>
                <separator/>
                <filter name="my_tickets" string="My Tickets"
                        domain="[('assigned_to', '=', uid)]"/>
                <filter name="open" string="Open"
                        domain="[('stage_id.is_closed', '=', False)]"/>
                <filter name="escalated" string="Escalated"
                        domain="[('is_escalated', '=', True)]"/>
                <filter name="critical" string="Critical"
                        domain="[('priority', '=', '3')]"/>
                <separator/>
                <filter name="by_stage" string="Group by Stage"
                        context="{'group_by': 'stage_id'}"/>
                <filter name="by_category" string="Group by Category"
                        context="{'group_by': 'category_id'}"/>
                <filter name="by_assignee" string="Group by Assignee"
                        context="{'group_by': 'assigned_to'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sole_support_ticket" model="ir.actions.act_window">
        <field name="name">Support Tickets</field>
        <field name="res_model">sole.support.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_sole_support_ticket_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
