<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sole_stk_push_wizard_form" model="ir.ui.view">
        <field name="name">sole.stk.push.wizard.form</field>
        <field name="model">sole.stk.push.wizard</field>
        <field name="arch" type="xml">
            <form string="Send STK Push">
                <group>
                    <group>
                        <field name="config_id"/>
                        <field name="phone"/>
                        <field name="amount"/>
                    </group>
                    <group>
                        <field name="account_ref"/>
                        <field name="transaction_desc"/>
                        <field name="partner_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send STK Push"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
