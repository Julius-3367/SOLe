<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- M-Pesa Config Form -->
    <record id="view_sole_mpesa_config_form" model="ir.ui.view">
        <field name="name">sole.mpesa.config.form</field>
        <field name="model">sole.mpesa.config</field>
        <field name="arch" type="xml">
            <form string="M-Pesa Configuration">
                <header>
                    <button name="action_test_token" type="object" string="Test Connection"
                            class="btn-primary"/>
                    <button name="action_register_c2b_urls" type="object"
                            string="Register C2B URLs" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transactions" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <field name="transaction_count" widget="statinfo" string="Transactions"/>
                        </button>
                    </div>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="environment"/>
                            <field name="is_active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Daraja API Credentials">
                            <field name="consumer_key" password="True"/>
                            <field name="consumer_secret" password="True"/>
                            <field name="shortcode"/>
                            <field name="passkey" password="True"/>
                        </group>
                    </group>
                    <group>
                        <group string="C2B Paybill">
                            <field name="c2b_shortcode"/>
                        </group>
                        <group string="Integration">
                            <field name="callback_url_base"/>
                            <field name="account_journal_id"/>
                        </group>
                    </group>
                    <group string="Callback URLs (register these with Safaricom)">
                        <div class="o_field_widget">
                            <p class="text-muted">
                                STK Push: <code>&lt;callback_url_base&gt;/sole/mpesa/stk/callback</code><br/>
                                C2B Validation: <code>&lt;callback_url_base&gt;/sole/mpesa/c2b/validation</code><br/>
                                C2B Confirmation: <code>&lt;callback_url_base&gt;/sole/mpesa/c2b/confirmation</code>
                            </p>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- M-Pesa Config List -->
    <record id="view_sole_mpesa_config_list" model="ir.ui.view">
        <field name="name">sole.mpesa.config.list</field>
        <field name="model">sole.mpesa.config</field>
        <field name="arch" type="xml">
            <list string="M-Pesa Configurations">
                <field name="name"/>
                <field name="environment"/>
                <field name="shortcode"/>
                <field name="callback_url_base"/>
                <field name="is_active"/>
                <field name="transaction_count"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sole_mpesa_config" model="ir.actions.act_window">
        <field name="name">M-Pesa Configuration</field>
        <field name="res_model">sole.mpesa.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
