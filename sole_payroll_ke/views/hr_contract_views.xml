<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_contract_form_ke" model="ir.ui.view">
        <field name="name">hr.contract.form.ke.payroll</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Kenyan Payroll" name="ke_payroll">
                    <group>
                        <group string="Allowances">
                            <field name="ke_food_allowance"/>
                            <field name="ke_airtime_allowance"/>
                            <field name="ke_pension_allowance"/>
                            <field name="ke_commuter_allowance"/>
                        </group>
                        <group string="Housing Allowance">
                            <field name="ke_housing_allowance_unit"/>
                            <field name="ke_housing_allowance_fixed"
                                   invisible="ke_housing_allowance_unit != 'fixed'"/>
                            <field name="ke_housing_allowance_percentage"
                                   invisible="ke_housing_allowance_unit != 'percentage'"/>
                        </group>
                        <group string="Insurance and Pension">
                            <field name="ke_pension_contribution"/>
                            <field name="ke_voluntary_medical_insurance"/>
                            <field name="ke_life_insurance"/>
                            <field name="ke_is_li_managed_by_employee"/>
                            <field name="ke_education"/>
                        </group>
                        <group string="Employment">
                            <field name="ke_is_secondary"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Food and airtime allowances are untaxed only up to their
                        statutory ceiling — above it, the whole allowance becomes
                        taxable, not just the excess. The pension allowance is
                        different: only the excess is taxed. The ceilings are set
                        under Payroll &gt; Configuration &gt; Payroll Rates.
                    </p>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
