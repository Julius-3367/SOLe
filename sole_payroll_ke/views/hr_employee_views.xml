<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_ke" model="ir.ui.view">
        <field name="name">hr.employee.form.ke.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <group string="Kenyan Payroll" name="ke_payroll">
                    <field name="ke_mortgage"/>
                    <field name="ke_disabled"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
