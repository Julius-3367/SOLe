<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Salary rule categories. Every rule belongs to one, and the rules
            add themselves up by category — a rule reads categories.BASIC to
            get the total of every rule in the BASIC category.

            Flat by design, matching the reference configuration. Nesting
            categories makes the totals harder to reason about, because a
            parent silently accumulates everything beneath it.

            noupdate="1" so that a module upgrade never overwrites a category
            an accountant has adjusted.
        -->
        <record id="categ_basic" model="hr.salary.rule.category">
            <field name="name">Basic</field>
            <field name="code">BASIC</field>
        </record>
        <record id="categ_alw" model="hr.salary.rule.category">
            <field name="name">Allowance</field>
            <field name="code">ALW</field>
        </record>
        <record id="categ_ke_ut_alw" model="hr.salary.rule.category">
            <field name="name">Untaxed Allowance</field>
            <field name="code">KE_UT_ALW</field>
            <field name="note">Allowances within their statutory limit. Excluded from taxable pay.</field>
        </record>
        <record id="categ_ke_t_alw" model="hr.salary.rule.category">
            <field name="name">Taxed Allowance</field>
            <field name="code">KE_T_ALW</field>
            <field name="note">Allowances that are taxable, either by nature or because they exceed their limit.</field>
        </record>
        <record id="categ_gross" model="hr.salary.rule.category">
            <field name="name">Taxable Salary</field>
            <field name="code">GROSS</field>
        </record>
        <record id="categ_ded" model="hr.salary.rule.category">
            <field name="name">Deduction</field>
            <field name="code">DED</field>
        </record>
        <record id="categ_statutory_ded" model="hr.salary.rule.category">
            <field name="name">Statutory Deduction</field>
            <field name="code">STATUTORY_DED</field>
            <field name="note">NSSF, SHIF, AHL and PAYE. Remitted to government bodies.</field>
        </record>
        <record id="categ_other_ded" model="hr.salary.rule.category">
            <field name="name">Other Deduction</field>
            <field name="code">OTHER_DED</field>
        </record>
        <record id="categ_total_ded" model="hr.salary.rule.category">
            <field name="name">Total Deduction</field>
            <field name="code">TOTAL_DED</field>
        </record>
        <record id="categ_ins_relief" model="hr.salary.rule.category">
            <field name="name">Insurance Relief</field>
            <field name="code">INS_RELIEF</field>
            <field name="note">The individual reliefs, before the overall cap is applied.</field>
        </record>
        <record id="categ_relief" model="hr.salary.rule.category">
            <field name="name">Relief</field>
            <field name="code">RELIEF</field>
            <field name="note">Reliefs that reduce tax payable, after capping. Held as negative amounts.</field>
        </record>
        <record id="categ_insurance" model="hr.salary.rule.category">
            <field name="name">Insurance</field>
            <field name="code">INSURANCE</field>
        </record>
        <record id="categ_nssf" model="hr.salary.rule.category">
            <field name="name">NSSF</field>
            <field name="code">NSSF</field>
        </record>
        <record id="categ_exemption" model="hr.salary.rule.category">
            <field name="name">Tax Exemption</field>
            <field name="code">EXEMPTION</field>
        </record>
        <record id="categ_comp" model="hr.salary.rule.category">
            <field name="name">Company Contribution</field>
            <field name="code">COMP</field>
            <field name="note">Employer costs. Shown on the payslip but not deducted from the employee.</field>
        </record>
        <record id="categ_net" model="hr.salary.rule.category">
            <field name="name">Net</field>
            <field name="code">NET</field>
        </record>
        <record id="categ_hidden" model="hr.salary.rule.category">
            <field name="name">Hidden (calculation only)</field>
            <field name="code">HIDDEN</field>
            <field name="note">Intermediate steps. These rules do not appear on the payslip; they exist so later rules can read their result.</field>
        </record>
    </data>
</odoo>
