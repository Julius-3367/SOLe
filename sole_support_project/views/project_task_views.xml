<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_form_support" model="ir.ui.view">
        <field name="name">project.task.form.support</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <field name="project_id" position="after">
                <field name="support_ticket_id" readonly="1"
                       invisible="not support_ticket_id"/>
            </field>
        </field>
    </record>

    <record id="view_project_task_search_support" model="ir.ui.view">
        <field name="name">project.task.search.support</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <filter name="my_tasks" position="after">
                <filter name="support_duties" string="Support Duties"
                        domain="[('support_ticket_id', '!=', False)]"/>
            </filter>
        </field>
    </record>
</odoo>
