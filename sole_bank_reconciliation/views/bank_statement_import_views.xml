<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Statement Import Form -->
    <record id="view_sole_bank_stmt_import_form" model="ir.ui.view">
        <field name="name">sole.bank.statement.import.form</field>
        <field name="model">sole.bank.statement.import</field>
        <field name="arch" type="xml">
            <form string="Bank Statement Import">
                <header>
                    <button name="action_mark_reconciled" type="object"
                            string="Mark as Reconciled" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,reconciled"/>
                </header>
                <sheet>
                    <div class="oe_stat_buttons" name="stat_buttons">
                        <div class="oe_stat_button">
                            <div class="o_stat_info">
                                <field name="total_lines" class="o_stat_value"/>
                                <span class="o_stat_text">Total Lines</span>
                            </div>
                        </div>
                        <div class="oe_stat_button">
                            <div class="o_stat_info">
                                <field name="matched_lines" class="o_stat_value"/>
                                <span class="o_stat_text">Matched</span>
                            </div>
                        </div>
                        <div class="oe_stat_button">
                            <div class="o_stat_info">
                                <field name="unmatched_lines" class="o_stat_value"/>
                                <span class="o_stat_text">Unmatched</span>
                            </div>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="journal_id"/>
                            <field name="bank_format"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Summary">
                            <field name="total_debit"/>
                            <field name="total_credit"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Statement Lines">
                            <field name="line_ids">
                                <list decoration-success="state=='matched'"
                                      decoration-muted="state=='ignored'"
                                      decoration-danger="state=='unmatched' and (debit + credit) > 0">
                                    <field name="transaction_date"/>
                                    <field name="ref"/>
                                    <field name="description"/>
                                    <field name="debit"/>
                                    <field name="credit"/>
                                    <field name="balance"/>
                                    <field name="state"/>
                                    <field name="matched_move_line_id"/>
                                    <field name="notes"/>
                                    <button name="action_match" type="object"
                                            string="Match" icon="fa-check"
                                            invisible="state != 'unmatched'"/>
                                    <button name="action_ignore" type="object"
                                            string="Ignore" icon="fa-times"
                                            invisible="state != 'unmatched'"/>
                                    <button name="action_unmatch" type="object"
                                            string="Unmatch" icon="fa-undo"
                                            invisible="state == 'unmatched'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Statement Import List -->
    <record id="view_sole_bank_stmt_import_list" model="ir.ui.view">
        <field name="name">sole.bank.statement.import.list</field>
        <field name="model">sole.bank.statement.import</field>
        <field name="arch" type="xml">
            <list string="Bank Statement Imports"
                  decoration-success="state=='reconciled'">
                <field name="name"/>
                <field name="journal_id"/>
                <field name="bank_format"/>
                <field name="total_lines"/>
                <field name="matched_lines"/>
                <field name="unmatched_lines"/>
                <field name="total_credit"/>
                <field name="state"/>
                <field name="create_date" string="Imported On"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sole_bank_stmt_import" model="ir.actions.act_window">
        <field name="name">Bank Statement Imports</field>
        <field name="res_model">sole.bank.statement.import</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
