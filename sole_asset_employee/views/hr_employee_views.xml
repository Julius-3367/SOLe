<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form.assets</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_assets" type="object" class="oe_stat_button" icon="fa-cubes"
                        groups="account.group_account_user" invisible="not asset_count">
                    <field name="asset_count" widget="statinfo" string="Assets"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
